<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Conector de MySQL para ADO.NET (MySqlConnection, MySqlCommand, MySqlDataReader) -->
    <PackageReference Include="MySql.Data" Version="26.10.0" />

    <!-- Reportes: exportar a Excel (.xlsx) -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />

    <!-- Reportes: exportar a PDF (licencia Community, gratuita para uso académico) -->
    <PackageReference Include="QuestPDF" Version="2026.9.2" />
  </ItemGroup>

</Project>
